# Environment variables for AI Pulse (copy to .env for local runs).
# In GitHub Actions these come from repository secrets/variables instead.

# Groq API key — powers the summaries, daily brief and weekly review.
# Free key: https://console.groq.com/keys. Without it the site still
# builds, just with feed excerpts instead of summaries.
GROQ_API_KEY=

# Optional: preferred Groq model, tried before the built-in fallbacks.
# Retired models are detected and skipped automatically.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: comma-separated fallback list (defaults are in llm.py).
# GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Optional: timezone that decides which calendar day a daily brief belongs to.
# NEWS_TZ=Asia/Kolkata
