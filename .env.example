# Required environment variables for News Bot
# Copy this file to .env and fill in your values.
# See README.md for setup instructions for each service.

# Groq API (LLM summarization)
GROQ_API_KEY=
# Optional. Overrides the default model. Set this if Groq retires the
# default and the watcher starts logging 404s from the chat endpoint.
# GROQ_MODEL=openai/gpt-oss-120b

# Telegram Bot (message delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upstash Redis (state storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
